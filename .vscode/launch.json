{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1:Email Extractor",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:hatch.envInterpreter}",
            "module": "european_remote.extractor",
            "args": [
                "-vvv",
                "data/emails/2026-10-09.sample.eml",
                "data/emails/2026-10-16.sample.eml",
                "data/emails/2026-10-23.sample.eml",
                "data/emails/2026-10-30.sample.eml"
            ],
        },
        {
            "name": "2:Job Content Fetcher",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:hatch.envInterpreter}",
            "module": "european_remote.fetcher",
            "args": ["-vvv"],
        },
        {
            "name": "3:Structured Job Data Extractor",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:hatch.envInterpreter}",
            "module": "european_remote.job_ad_extractor",
            "args": ["--dry-run", "-vvv", "-l", "10"],
        }
    ]
}
